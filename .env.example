# Copy to .env.local. Never commit .env.local.

# Demo mode: "true" serves bundled demo data without Clerk or Supabase.
# Must be "false" in production.
NEXT_PUBLIC_DEMO_MODE=true

# Clerk (identity authority). Only the publishable key reaches the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase. Only the publishable key reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared secret for /api/cron/ingest and /api/cron/process-links.
# Must equal the Supabase Vault secret `marky_worker_secret`.
CRON_SECRET=
