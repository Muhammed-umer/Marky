# Copy to .env.local for local development. Never commit .env.local or real secrets.

# Demo mode: "true" serves bundled demo data without Clerk or Supabase.
# Must be "false" in production or active development testing.
NEXT_PUBLIC_DEMO_MODE=false

# Clerk Identity Authentication Keys
# Development Mode (Local & Vercel Preview): Use matching pk_test_... and sk_test_... from the SAME Clerk instance.
# Production Mode: Use matching pk_live_... and sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Clerk Fallback Redirect URLs (App Router)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Shared Secret for Ingestion Cron (/api/cron/ingest)
CRON_SECRET=dev_cron_secret_placeholder
MARKY_CRON_URL=http://localhost:3000/api/cron/ingest
